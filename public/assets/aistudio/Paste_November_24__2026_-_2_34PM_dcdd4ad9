        id: "7f9c2d18-3a9b-4e8c-a012-9c1e40b3f811",
        title: "Integrate Supabase Auth & JWT refresh tokens",
        description: "Configure Next.js edge middleware and secure cookies for database row-level security (RLS).",
        is_completed: false,
        created_at: new Date(Date.now() - 3600000 * 2).toISOString()
      },
      {
        id: "8a1b3c29-4d0e-5f9a-b123-0d2f51c4a922",
        title: "Design PostgreSQL todos table schema and migration",
        description: "Include uuid primary keys, timestamptz default now(), and optimize index on is_completed.",
        is_completed: true,
        created_at: new Date(Date.now() - 3600000 * 24).toISOString()
      },
      {
        id: "9b2c4d30-5e1f-6a0b-c234-1e3a62d5b033",
        title: "Implement optimistic UI toggles and error boundaries",
        description: "Provide tactile visual responses instantly while background replication resolves.",
        is_completed: false,
        created_at: new Date(Date.now() - 3600000 * 5).toISOString()
      }
    ];

    const STORAGE_KEY = "taskflow_todos_mvp";

    // Application State
    let todos = [];
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      todos = stored ? JSON.parse(stored) : INITIAL_TODOS;
    } catch (e) {
      todos = INITIAL_TODOS;
    }

    let activeFilter = "all"; // 'all' | 'pending' | 'completed'
    let searchQuery = "";
    let taskPendingDeleteId = null;

    // DOM Elements
    const tasksContainer = document.getElementById("tasksContainer");
    const emptyState = document.getElementById("emptyState");
    const createTaskForm = document.getElementById("createTaskForm");
    const taskTitleInput = document.getElementById("taskTitle");
    const taskDescInput = document.getElementById("taskDescription");
    const titleError = document.getElementById("titleError");
    const searchInput = document.getElementById("taskSearchInput");
    const filterTabs = document.querySelectorAll(".filter-tab");
    const syncTimestamp = document.getElementById("syncTimestamp");
    const manualSyncBtn = document.getElementById("manualSyncBtn");
    const emptyStateCtaBtn = document.getElementById("emptyStateCtaBtn");

    // Stats Elements
    const statTotal = document.getElementById("statTotal");
    const statPending = document.getElementById("statPending");
    const statCompleted = document.getElementById("statCompleted");
    const statRate = document.getElementById("statRate");
    const statProgressRing = document.getElementById("statProgressRing");
    const tabCountAll = document.getElementById("tabCountAll");
    const tabCountPending = document.getElementById("tabCountPending");
    const tabCountCompleted = document.getElementById("tabCountCompleted");

    // Modal Elements
    const editModal = document.getElementById("editModal");
    const editTaskForm = document.getElementById("editTaskForm");
    const editTaskIdInput = document.getElementById("editTaskId");
    const editTaskTitleInput = document.getElementById("editTaskTitle");
    const editTaskDescInput = document.getElementById("editTaskDescription");
    const editTitleError = document.getElementById("editTitleError");
    const closeEditModalBtn = document.getElementById("closeEditModalBtn");
    const cancelEditBtn = document.getElementById("cancelEditBtn");

    const deleteModal = document.getElementById("deleteModal");
    const deleteTaskTitleSnippet = document.getElementById("deleteTaskTitleSnippet");
    const cancelDeleteBtn = document.getElementById("cancelDeleteBtn");
    const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
      } catch (err) {
        console.warn("Could not save to localStorage", err);
      }
      updateStats();
      renderTasks();
      updateSyncTime();
    }

    function updateSyncTime() {
      const d = new Date();
      syncTimestamp.textContent = "Synced at " + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }

    function formatRelativeDate(isoStr) {
      try {
        const date = new Date(isoStr);
        const now = new Date();
        const diffMs = now - date;
        const diffMins = Math.floor(diffMs / 60000);
        const diffHours = Math.floor(diffMins / 60);
        const diffDays = Math.floor(diffHours / 24);

        if (diffMins < 2) return "Just now";
        if (diffMins < 60) return `${diffMins}m ago`;
        if (diffHours < 24) return `${diffHours}h ago`;
        if (diffDays < 7) return `${diffDays}d ago`;
        return date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
      } catch (e) {
        return "Recent";
      }
    }

    function updateStats() {
      const total = todos.length;
      const completed = todos.filter(t => t.is_completed).length;
      const pending = total - completed;
      const rate = total === 0 ? 0 : Math.round((completed / total) * 100);

      statTotal.textContent = total;
      statPending.textContent = pending;
      statCompleted.textContent = completed;
      statRate.textContent = `${rate}%`;

      tabCountAll.textContent = total;
      tabCountPending.textContent = pending;
      tabCountCompleted.textContent = completed;

      // Update circular SVG progress
      const circumference = 88; // 2 * pi * r (14) approx 88
      const offset = circumference - (rate / 100) * circumference;
      statProgressRing.style.strokeDashoffset = offset;
    }

    function getFilteredTodos() {
      return todos.filter(todo => {
        // Tab Filter
        if (activeFilter === "pending" && todo.is_completed) return false;
        if (activeFilter === "completed" && !todo.is_completed) return false;

        // Search Filter
        if (searchQuery.trim() !== "") {
          const q = searchQuery.toLowerCase();
          const matchTitle = (todo.title || "").toLowerCase().includes(q);
          const matchDesc = (todo.description || "").toLowerCase().includes(q);
          return matchTitle || matchDesc;
        }

        return true;
      });
    }

    function renderTasks() {
      const filtered = getFilteredTodos();
      tasksContainer.innerHTML = "";

      if (filtered.length === 0) {
        emptyState.classList.remove("hidden");
        return;
      }

      emptyState.classList.add("hidden");

      filtered.forEach(todo => {
        const card = document.createElement("div");
        const isComp = todo.is_completed;

        card.className = `p-space-md rounded-xl transition-all duration-200 shadow-sm hover:shadow-md flex flex-col sm:flex-row items-start justify-between gap-space-md ${
          isComp ? "bg-surface-container-low/70" : "bg-surface-container-lowest"
        }`;

        // Left section: Checkbox + Content
        const leftWrap = document.createElement("div");
        leftWrap.className = "flex items-start gap-space-md min-w-0 flex-1";

        // Custom Interactive Checkbox
        const checkboxBtn = document.createElement("button");
        checkboxBtn.type = "button";
        checkboxBtn.setAttribute("aria-label", isComp ? "Mark as pending" : "Mark as completed");
        checkboxBtn.className = `mt-0.5 w-6 h-6 rounded-md flex items-center justify-center shrink-0 transition-all ${
          isComp 
            ? "bg-secondary text-on-secondary shadow-sm scale-100" 
            : "bg-surface-container-highest hover:bg-primary-fixed text-transparent hover:text-primary/50"
        }`;
        checkboxBtn.innerHTML = `<span class="material-symbols-outlined text-[18px] font-bold">check</span>`;
        checkboxBtn.addEventListener("click", () => toggleTaskComplete(todo.id));

        // Details Container
        const details = document.createElement("div");
        details.className = "min-w-0 flex-1";

        // Title and description
        const titleEl = document.createElement("h4");
        titleEl.className = `font-headline-sm text-headline-sm font-semibold transition-all break-words ${
          isComp ? "line-through text-outline" : "text-on-surface"
        }`;
        titleEl.textContent = todo.title;

        details.appendChild(titleEl);

        if (todo.description && todo.description.trim() !== "") {
          const descEl = document.createElement("p");
          descEl.className = `font-body-md text-body-md mt-1 break-words ${
            isComp ? "text-outline/80 line-through" : "text-on-surface-variant"
          }`;
          descEl.textContent = todo.description;
          details.appendChild(descEl);
        }

        // Metadata badges row
        const metaRow = document.createElement("div");
        metaRow.className = "flex items-center gap-space-sm mt-3 flex-wrap";

        // Status Badge
        const statusBadge = document.createElement("span");
        if (isComp) {
          statusBadge.className = "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-secondary-fixed text-on-secondary-fixed";
          statusBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> Completed`;
        } else {
          statusBadge.className = "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-tertiary-fixed text-on-tertiary-fixed";
          statusBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span> Pending`;
        }
        metaRow.appendChild(statusBadge);

        // Timestamp Badge
        const timeBadge = document.createElement("span");
        timeBadge.className = "inline-flex items-center gap-1 font-label-sm text-label-sm text-on-surface-variant";
        timeBadge.innerHTML = `<span class="material-symbols-outlined text-[14px]">calendar_today</span> ${formatRelativeDate(todo.created_at)}`;
        metaRow.appendChild(timeBadge);

        // UUID Snippet (Supabase feel)
        const idBadge = document.createElement("span");
        idBadge.className = "font-mono text-[10px] text-outline px-1.5 py-0.5 rounded bg-surface-container hidden md:inline-block";
        idBadge.textContent = todo.id.slice(0, 8);
        metaRow.appendChild(idBadge);

        details.appendChild(metaRow);
        leftWrap.appendChild(checkboxBtn);
        leftWrap.appendChild(details);

        // Right actions: Edit & Delete buttons
        const actionsWrap = document.createElement("div");
        actionsWrap.className = "flex items-center gap-1 shrink-0 self-end sm:self-center";

        const editBtn = document.createElement("button");
        editBtn.type = "button";
        editBtn.setAttribute("aria-label", "Edit task");
        editBtn.className = "w-8 h-8 rounded-lg flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors";
        editBtn.innerHTML = `<span class="material-symbols-outlined text-[18px]">edit</span>`;
        editBtn.addEventListener("click", () => openEditModal(todo.id));

        const delBtn = document.createElement("button");
        delBtn.type = "button";
        delBtn.setAttribute("aria-label", "Delete task");
        delBtn.className = "w-8 h-8 rounded-lg flex items-center justify-center text-on-surface-variant hover:text-error hover:bg-error-container/40 transition-colors";
        delBtn.innerHTML = `<span class="material-symbols-outlined text-[18px]">delete</span>`;
        delBtn.addEventListener("click", () => openDeleteModal(todo.id, todo.title));

        actionsWrap.appendChild(editBtn);
        actionsWrap.appendChild(delBtn);

        card.appendChild(leftWrap);
        card.appendChild(actionsWrap);
        tasksContainer.appendChild(card);
      });
    }

    // CRUD ACTIONS
    function toggleTaskComplete(id) {
      todos = todos.map(todo => {
        if (todo.id === id) {
          return { ...todo, is_completed: !todo.is_completed };
        }
        return todo;
      });
      saveState();
    }

    function createNewTask(title, description) {
      const newTask = {
        id: crypto.randomUUID ? crypto.randomUUID() : 'task-' + Date.now(),
        title: title.trim(),
        description: description.trim(),
        is_completed: false,
        created_at: new Date().toISOString()
      };
      todos.unshift(newTask);
      saveState();
    }

    function updateTask(id, newTitle, newDescription) {
      todos = todos.map(t => {
        if (t.id === id) {
          return {
            ...t,
            title: newTitle.trim(),
            description: newDescription.trim()
          };
        }
        return t;
      });
      saveState();
    }

    function deleteTask(id) {
      todos = todos.filter(t => t.id !== id);
      saveState();
    }

    // Modal Operations
    function openEditModal(id) {
      const todo = todos.find(t => t.id === id);
      if (!todo) return;

      editTaskIdInput.value = todo.id;
      editTaskTitleInput.value = todo.title;
      editTaskDescInput.value = todo.description || "";
      editTitleError.classList.add("hidden");

      editModal.classList.remove("hidden");
      editTaskTitleInput.focus();
    }

    function closeEditModal() {
      editModal.classList.add("hidden");
    }

    function openDeleteModal(id, title) {
      taskPendingDeleteId = id;
      deleteTaskTitleSnippet.textContent = `"${title}"`;
      deleteModal.classList.remove("hidden");
    }

    function closeDeleteModal() {
      taskPendingDeleteId = null;
      deleteModal.classList.add("hidden");
    }

    // EVENT LISTENERS
    createTaskForm.addEventListener("submit", function (e) {
      e.preventDefault();
      const val = taskTitleInput.value.trim();
      if (!val) {
        titleError.classList.remove("hidden");
        taskTitleInput.focus();
        return;
      }
      titleError.classList.add("hidden");
      createNewTask(val, taskDescInput.value);
      taskTitleInput.value = "";
      taskDescInput.value = "";
      taskTitleInput.focus();
    });

    taskTitleInput.addEventListener("input", function () {
      if (taskTitleInput.value.trim() !== "") {
        titleError.classList.add("hidden");
      }
    });

    editTaskForm.addEventListener("submit", function (e) {
      e.preventDefault();
      const id = editTaskIdInput.value;
      const val = editTaskTitleInput.value.trim();
      if (!val) {
        editTitleError.classList.remove("hidden");
        editTaskTitleInput.focus();
        return;
      }
      editTitleError.classList.add("hidden");
      updateTask(id, val, editTaskDescInput.value);
      closeEditModal();
    });

    editTaskTitleInput.addEventListener("input", function () {
      if (editTaskTitleInput.value.trim() !== "") {
        editTitleError.classList.add("hidden");
      }
    });

    closeEditModalBtn.addEventListener("click", closeEditModal);
    cancelEditBtn.addEventListener("click", closeEditModal);

    cancelDeleteBtn.addEventListener("click", closeDeleteModal);
    confirmDeleteBtn.addEventListener("click", function () {
      if (taskPendingDeleteId) {
        deleteTask(taskPendingDeleteId);
        closeDeleteModal();
      }
    });

    // Close modals on clicking overlay backdrop
    editModal.addEventListener("click", function (e) {
      if (e.target === editModal) closeEditModal();
    });
    deleteModal.addEventListener("click", function (e) {
      if (e.target === deleteModal) closeDeleteModal();
    });

    // Filter Tabs
    filterTabs.forEach(tab => {
      tab.addEventListener("click", function () {
        filterTabs.forEach(t => {
          t.classList.remove("bg-surface-container-lowest", "text-primary", "shadow-sm", "font-semibold");
          t.classList.add("text-on-surface-variant", "font-medium");
        });
        tab.classList.add("bg-surface-container-lowest", "text-primary", "shadow-sm", "font-semibold");
        tab.classList.remove("text-on-surface-variant", "font-medium");

        activeFilter = tab.getAttribute("data-filter");
        renderTasks();
      });
    });

    // Search Input
    searchInput.addEventListener("input", function (e) {
      searchQuery = e.target.value;
      renderTasks();
    });

    // Manual Refresh Simulation
    manualSyncBtn.addEventListener("click", function () {
      manualSyncBtn.querySelector("span").classList.add("animate-spin");
      setTimeout(() => {
        manualSyncBtn.querySelector("span").classList.remove("animate-spin");
        updateSyncTime();
      }, 500);
    });

    emptyStateCtaBtn.addEventListener("click", function () {
      // Switch filter back to all if needed
      if (activeFilter !== "all") {
        document.querySelector('[data-filter="all"]').click();
      }
      taskTitleInput.focus();
    });

    // Initial run
    updateStats();
    renderTasks();
  })();
</script></div></main><footer class="w-full bg-surface-container-lowest border-t border-outline-variant/40 mt-auto"><div class="max-w-7xl mx-auto px-margin-desktop py-space-lg flex flex-col sm:flex-row items-center justify-between gap-space-sm text-on-surface-variant"><div class="flex items-center gap-space-xs"><span class="font-label-sm text-label-sm font-semibold text-on-surface">TaskFlow</span><span class="font-body-sm text-body-sm">© 2025 MVP Engine. All rights reserved.</span></div><div class="flex items-center gap-space-md font-body-sm text-body-sm"><span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-secondary"></span> Real-time Sync Active</span><a class="hover:text-on-surface transition-colors" data-path="settings" href="#">Settings</a><a class="hover:text-on-surface transition-colors" data-path="help" href="#">Docs</a></div></div></footer></body></html>